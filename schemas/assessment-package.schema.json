{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eng-essay-qgen.local/schemas/assessment-package.schema.json",
  "title": "English Essay Assessment Package",
  "description": "The private source of truth for a student assessment and its teacher-only material.",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "metadata",
    "passage",
    "task",
    "conditions",
    "rubric",
    "language_policy",
    "model_answers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "passage": {
      "$ref": "#/$defs/passage"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "conditions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/rubric_item"
      }
    },
    "language_policy": {
      "$ref": "#/$defs/language_policy"
    },
    "model_answers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/model_answer"
      }
    },
    "differentiated_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/differentiated_level"
      }
    },
    "lesson_plan": {
      "type": "object"
    },
    "qa_results": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "topic",
        "grade",
        "question_type",
        "total_points"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "enum": ["중1", "중2", "중3", "고1", "고2/3"]
        },
        "question_type": {
          "type": "string",
          "enum": ["type1", "type2", "type3", "differentiated"]
        },
        "total_points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "source_passage_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "passage": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "genre": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["instruction_ko"],
      "properties": {
        "instruction_ko": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "response_format": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "required": ["id", "category", "text_ko", "validation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "category": {
          "type": "string",
          "enum": ["length", "grammar", "content", "restriction", "format", "citation"]
        },
        "text_ko": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["kind", "check_mode", "params"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "word_count",
            "surface_pattern",
            "literal_required",
            "ngram_limit",
            "format",
            "semantic"
          ]
        },
        "check_mode": {
          "type": "string",
          "enum": ["deterministic", "semantic", "manual"]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rubric_item": {
      "type": "object",
      "required": ["id", "condition_ids", "points", "full_credit_ko"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "condition_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "full_credit_ko": {
          "type": "string",
          "minLength": 1
        },
        "partial_credit_ko": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "language_policy": {
      "type": "object",
      "required": [
        "error_penalty",
        "max_language_penalty",
        "repeated_error_policy",
        "double_penalty_allowed"
      ],
      "properties": {
        "error_penalty": {
          "type": "number",
          "minimum": 0
        },
        "max_language_penalty": {
          "type": "number",
          "minimum": 0
        },
        "repeated_error_policy": {
          "type": "string",
          "enum": ["same-root-once", "each-occurrence"]
        },
        "double_penalty_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "model_answer": {
      "type": "object",
      "required": ["id", "level", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "level": {
          "type": "string",
          "enum": ["minimum-pass", "proficient", "alternative", "common-error"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "rationale_ko": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "differentiated_level": {
      "type": "object",
      "required": ["id", "label", "instruction_ko", "conditions", "rubric", "model_answers"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^level[1-3]$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "instruction_ko": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rubric_item"
          }
        },
        "model_answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/model_answer"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
