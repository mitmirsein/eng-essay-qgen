{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eng-essay-qgen.local/schemas/lesson-plan.schema.json",
  "title": "English Essay Lesson Plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "overview",
    "standards",
    "passage_analysis",
    "sequence",
    "differentiation",
    "misconceptions",
    "answer_planning",
    "scoring_anchors",
    "formative_assessment"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.0\\.0$"},
    "assessment_id": {"type": "string", "minLength": 3},
    "overview": {"$ref": "#/$defs/overview"},
    "standards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/standard"}},
    "passage_analysis": {"$ref": "#/$defs/passage_analysis"},
    "sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sequence_item"}},
    "differentiation": {"$ref": "#/$defs/differentiation"},
    "misconceptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/misconception"}},
    "answer_planning": {"$ref": "#/$defs/answer_planning"},
    "scoring_anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scoring_anchor"}},
    "formative_assessment": {"$ref": "#/$defs/formative_assessment"}
  },
  "additionalProperties": true,
  "$defs": {
    "overview": {
      "type": "object",
      "required": ["grade", "duration_minutes", "lesson_mode", "materials", "objectives"],
      "properties": {
        "grade": {"type": "string", "enum": ["중1", "중2", "중3", "고1", "고2/3"]},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
        "lesson_mode": {"type": "string", "minLength": 1},
        "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "standard": {
      "type": "object",
      "required": ["code", "statement_ko", "performance_verb", "lesson_evidence", "condition_ids"],
      "properties": {
        "code": {"type": "string", "minLength": 3},
        "statement_ko": {"type": "string", "minLength": 1},
        "performance_verb": {"type": "string", "minLength": 1},
        "lesson_evidence": {"type": "string", "minLength": 1},
        "condition_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "passage_analysis": {
      "type": "object",
      "required": ["flow", "key_vocabulary", "target_grammar", "background_knowledge"],
      "properties": {
        "flow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "key_vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target_grammar": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "background_knowledge": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "sequence_item": {
      "type": "object",
      "required": [
        "phase",
        "minutes",
        "teacher_actions",
        "student_actions",
        "questions",
        "expected_responses",
        "checks_for_understanding"
      ],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "minutes": {"type": "integer", "minimum": 1, "maximum": 180},
        "teacher_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "student_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_responses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "checks_for_understanding": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "differentiation": {
      "type": "object",
      "required": ["support", "core", "extension"],
      "properties": {
        "support": {"$ref": "#/$defs/support"},
        "core": {"$ref": "#/$defs/core"},
        "extension": {"$ref": "#/$defs/extension"}
      },
      "additionalProperties": true
    },
    "support": {
      "type": "object",
      "required": ["sentence_frames", "word_bank", "hints"],
      "properties": {
        "sentence_frames": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "word_bank": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "hints": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "core": {
      "type": "object",
      "required": ["organizer", "prompts"],
      "properties": {
        "organizer": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "prompts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "extension": {
      "type": "object",
      "required": ["prompts", "challenge_criteria"],
      "properties": {
        "prompts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "challenge_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "misconception": {
      "type": "object",
      "required": ["pattern", "diagnostic_question", "teacher_response", "mini_lesson"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "diagnostic_question": {"type": "string", "minLength": 1},
        "teacher_response": {"type": "string", "minLength": 1},
        "mini_lesson": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "answer_planning": {
      "type": "object",
      "required": ["condition_to_sentence_map", "self_checklist"],
      "properties": {
        "condition_to_sentence_map": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "self_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "scoring_anchor": {
      "type": "object",
      "required": ["score", "rationale_ko"],
      "properties": {
        "score": {"type": "number", "minimum": 0},
        "answer_id": {"type": "string"},
        "text": {"type": "string"},
        "rationale_ko": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "formative_assessment": {
      "type": "object",
      "required": ["mid_lesson_check", "peer_checklist", "exit_ticket", "follow_up"],
      "properties": {
        "mid_lesson_check": {"type": "string", "minLength": 1},
        "peer_checklist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_ticket": {"type": "string", "minLength": 1},
        "follow_up": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
